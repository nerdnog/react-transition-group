{
  "name": "@nerdnog/react-transition-group",
  "version": "4.5.0",
  "description": "Unofficial fork of react-transition-group that keeps working on React 19",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "scripts": {
    "test": "npm run lint && npm run testonly",
    "testonly": "jest --verbose",
    "tdd": "jest --watch",
    "build": "rimraf lib && npm run build:cjs && npm run build:esm && npm run build:dist && node scripts/write-lib-package.js",
    "build:cjs": "babel src --out-dir lib/cjs",
    "build:esm": "cross-env BABEL_ENV=esm babel src --out-dir lib/esm",
    "build:dist": "cross-env BABEL_ENV=esm rollup -c",
    "fix": "run-s fix:eslint fix:prettier",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:prettier": "npm run lint:prettier -- --write",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "check:layout": "node scripts/check-layout.js",
    "smoke:prod": "node scripts/smoke-prod.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nerdnog/react-transition-group.git"
  },
  "keywords": [
    "react",
    "transition",
    "addons",
    "transition-group",
    "animation",
    "css",
    "transitions"
  ],
  "author": "",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/nerdnog/react-transition-group/issues"
  },
  "homepage": "https://github.com/nerdnog/react-transition-group#readme",
  "jest": {
    "testRegex": "-test\\.js",
    "setupFiles": [
      "./test/setup.js"
    ],
    "setupFilesAfterEnv": [
      "./test/setupAfterEnv.js"
    ],
    "roots": [
      "<rootDir>/test"
    ],
    "testEnvironment": "jsdom"
  },
  "peerDependencies": {
    "react": ">=16.6.0",
    "react-dom": ">=16.6.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.5.5",
    "dom-helpers": "^5.0.1",
    "loose-envify": "^1.4.0",
    "prop-types": "^15.6.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@typescript-eslint/eslint-plugin": "^4.26.1",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-preset-jason": "^6.2.0",
    "cross-env": "^7.0.2",
    "eslint": "^7.28.0",
    "eslint-config-jason": "^8.1.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.6.1",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-replace": "^2.2.0",
    "rollup-plugin-terser": "^5.3.0",
    "typescript": "^4.9.5"
  },
  "browserify": {
    "transform": [
      "loose-envify"
    ]
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
